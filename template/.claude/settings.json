{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "{{models.tl}}",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh api --method GET repos/antarsoft/morphness/*)",
      "Bash(curl -fsSL https://api.github.com/repos/antarsoft/morphness/*)",
      "Bash(curl -fsSL https://raw.githubusercontent.com/antarsoft/morphness/*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git push -u origin:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(mkdir -p:*)",
      "Bash(tail:*)",
      "Bash(bash scripts/feature-cost.sh:*)",
      "Bash(bash scripts/prune-counter.sh:*)",
      "Bash(bash scripts/evidence.sh:*)",
      "Bash(bash scripts/learned-rules.sh:*)",
      "Bash(cat > /tmp/*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.prod)",
      "Read(./**/.env.development)",
      "Read(./**/.env.dev)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.stage)",
      "Read(./**/.env.test)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.*.local)",
      "Edit(./**/.env.production)",
      "Edit(./**/.env.prod)",
      "Edit(./**/.env.development)",
      "Edit(./**/.env.dev)",
      "Edit(./**/.env.staging)",
      "Edit(./**/.env.stage)",
      "Edit(./**/.env.test)",
      "Read(./**/.envrc)",
      "Edit(./**/.envrc)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Read(**/id_rsa)",
      "Edit(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Edit(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Edit(**/id_ecdsa)",
      "Read(**/.netrc)",
      "Edit(**/.netrc)",
      "Read(**/.pgpass)",
      "Edit(**/.pgpass)",
      "Read(**/.git-credentials)",
      "Edit(**/.git-credentials)",
      "Read(**/credentials.json)",
      "Edit(**/credentials.json)",
      "Read(**/credentials.yml)",
      "Edit(**/credentials.yml)",
      "Read(**/secrets.json)",
      "Edit(**/secrets.json)",
      "Read(**/secrets.yml)",
      "Edit(**/secrets.yml)",
      "Read(**/secrets.yaml)",
      "Edit(**/secrets.yaml)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.azure/**)",
      "Edit(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Edit(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(git push* {{branches.production}})",
      "Bash(git push* {{branches.production}} *)",
      "Bash(git push*:{{branches.production}})",
      "Bash(git push*:{{branches.production}} *)",
      "Bash(git push* {{branches.integration}})",
      "Bash(git push* {{branches.integration}} *)",
      "Bash(git push*:{{branches.integration}})",
      "Bash(git push*:{{branches.integration}} *)",
      "Bash(git push*--force*)",
      "Bash(git push -f*)",
      "Bash(git push* -f *)",
      "Bash(git push* -f)",
      "Bash(git push* +*)"
    ],
    "ask": [
      "Bash(*session-start.sh --accept*)",
      "Bash(git push)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(*| sh)",
      "Bash(*| sh *)",
      "Bash(*| bash)",
      "Bash(*| bash *)",
      "Bash(git -C * push*)",
      "Bash(gh pr merge*)",
      "Bash(glab mr merge*)",
      "Bash(gh api*/merge*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|MultiEdit|Write|NotebookEdit|Grep|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/guard.sh\"; rc=$?; [ \"$rc\" = 0 ] || [ \"$rc\" = 2 ] || { echo \"Blocked: scripts/guard.sh is missing or failed (exit $rc), so the call can't be checked. The guard fails closed: restore the file in a terminal (git checkout -- scripts/guard.sh), then retry.\" >&2; exit 2; }; exit \"$rc\"",
            "timeout": 60
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/guard.sh\"; rc=$?; [ \"$rc\" = 0 ] || [ \"$rc\" = 2 ] || { echo \"Blocked: scripts/guard.sh is missing or failed (exit $rc), so the call can't be checked. The guard fails closed: restore the file in a terminal (git checkout -- scripts/guard.sh), then retry.\" >&2; exit 2; }; exit \"$rc\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-start.sh\""
          }
        ]
      }
    ]
  }
}
